# Tic Tac Toe web build for appversegames.com/play/tictactoe/
#
# Flutter does not put content hashes in main.dart.js, flutter_bootstrap.js
# or assets/*, so nothing here may be cached long-term or as immutable:
# browsers revalidate every file (cheap 304s) and pick up new builds at once.

<IfModule mod_mime.c>
  AddType application/wasm            .wasm
  AddType text/javascript             .mjs
  AddType application/javascript      .js
  AddType application/json            .json
  AddType font/otf                    .otf
  AddType font/ttf                    .ttf
  AddType application/octet-stream    .bin .frag
  AddType application/octet-stream    .symbols
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/wasm
  AddOutputFilterByType DEFLATE font/otf font/ttf application/octet-stream
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|wasm|json|bin|otf|ttf|frag|png|ico|symbols)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>
